  m_Material: {fileID: -4337253834755674277}
  m_SourceFontFileGUID: 80141168febcf7b448973267147521c3
  m_CreationSettings:
    sourceFontFileName: 
    sourceFontFileGUID: 80141168febcf7b448973267147521c3
    faceIndex: 0
    pointSizeSamplingMode: 0
    pointSize: 46
    padding: 5
    paddingMode: 2
    packingMode: 0
    atlasWidth: 1024
    atlasHeight: 1024
    characterSetSelectionMode: 7
    characterSequence: " \uAC00\uAC15\uAC19\uAC83\uACE0\uACFC\uAD81\uADF8\uAE00\uAE30\uAE34\uAE38\uAF42\uB098\uB0A1\uB180\uB290\uB294\uB2D8\uB2E4\uB2F3\uB300\uB370\uB3C4\uB3D9\uB450\uB514\uB77C\uB78C\uB824\uB85C\uB85D\uB974\uB97C\uB9AC\uB9C8\uB9CC\uB9DE\uBA74\uBB34\uBB3C\uBB54\uBC31\"\uB204\uAD70\uAC00\uC758
      <b>\uC77C\uAE30</b>\uCC98\uB7FC \uBCF4\uC778\uB2E4.\uADF8\uB807\uB2E4\uBA74
      ...\uC804\uCCB4\uC74C\uB7C9\uBC30\uACBD\uC74C\uC545\uD6A8\uACFC\uC74C\n\uD760...
      \uBAB0\uB798 \uD55C\uBC88 \uC77D\uC5B4\uBCFC\uAE4C?\"\uBCF4\uBCF8\uC0AC\uC0B0\uC0BC\uC0C1\"\uAF64
      \uC624\uB798\uB41C \uD3B8\uC9C0 \uAC19\uC740\uB370. <b>\uC0AC\uB77C\uC9C4 \uC544\uAC00\uC528\uC640
      \uC720\uB839 \uC800\uD0DD</b>\uC774\uB77C.. \uD765\uBBF8\uB86D\uAD70.\"\uD654\uBAA9\uD588\uB358
      \uAC83\uB9CC \uAC19\uC740 \uC800\uD0DD\uC778\uB370..\uC870\uC791\uAC00\uB2A5\uD55C
      \uC2DC\uACC4\"\uBA48\uCDB0\uBC84\uB9B0 \uC2DC\uACC4\uB2E4.\"\uD53C\uAC00 \uBB3B\uC5B4\uC788\uB294
      \uC815\uBB3C\uD654\uB2E4. \uC791\uC740 \uBA54\uBAA8\uAC00 \uBD99\uC5B4\uC788\uB2E4.\"\uD0D0\uC815\uC73C\uB85C\uC11C
      \uD56D\uC0C1 \uBAB8\uC5D0 \uC9C0\uB2C8\uB294 \uD39C\uC774\uB2E4.\n\uC5B4\uB518\uAC00
      \uC4F8 \uB370\uAC00 \uC788\uC73C\uB824\uB098.\"<b>\uCD95\uBCF5</b>\uC758 \uC544\uB798... 
      \"\uADF8\" \uC544\uAC00\uC528\uAC00 <b>\uCD95\uBCF5</b>\uC774\uC5C8\uB358 \uAC70\uAD70.\uADF8\uB098\uC800\uB098
      \uC1E0\uC9C0\uB81B\uB300\uB77C... \uC5B4\uB514\uC5D0 \uC368\uC57C\uD560\uAE4C?\"\uD2BC\uD2BC\uD574\uBCF4\uC774\uB294
      <b>\uC1E0\uC9C0\uB81B\uB300</b>.\uBB54\uAC00 \uB4E4\uC5B4\uC788\uC744 \uAC83
      \uAC19\uC740 <b>\uC5F4\uB9AC\uC9C0 \uC54A\uB294 \uC0C1\uC790</b>\uB2E4.\uD2B9\uBCC4\uD788
      \uC7A0\uAE08\uC7A5\uCE58\uB294 \uC548 \uBCF4\uC774\uC9C0\uB9CC \uB179\uC2AC\uC5B4
      \uAFC8\uCA4D\uB3C4 \uC54A\uB294\uB2E4.\uC544\uBB34\uB9AC \uD798\uC744 \uC918\uB3C4
      \uC5F4\uB9AC\uC9C0 \uC54A\uB294\uB2E4.<b>\uB3C4\uAD6C</b>\uAC00 \uD544\uC694\uD560
      \uAC83 \uAC19\uB2E4.\uC9C1\uC811 \uB9CC\uB4E0 \uC778\uD615\uC778\uAC00. \uC624\uB798\uB418\uC5B4
      \uADF8\uB7F0\uC9C0 \uC0C9\uC774 \uB9CE\uC774 \uBC14\uB7AC\uB2E4.<i>\uADF8\uB798\uB3C4
      \uC774\uAC74 \uC870\uAE08 \uC73C\uC2A4\uC2A4\uD558\uAC8C \uC0DD\uAE30\uC9C0
      \uC54A\uC558\uB098...?</i>\uC544\uBB34\uAC83\uB3C4 \uC5C6\uB294 \uC720\uC544\uC6A9
      \uCE68\uB300\uC5D0 \uB369\uADF8\uB7EC\uB2C8 \uB193\uC778 \uC778\uD615\uC774\uB2E4.\uBA3C\uC9C0\uAC00
      \uB9CE\uC774 \uC313\uC5EC\uC788\uB2E4.\n<i>\uC815\uBB3C\uD654\uC5D0 \uAD00\uD55C
      \uBA54\uBAA8\uC9C0\uC77C\uAE4C? \uC790\uC138\uD788 \uBCFC \uD544\uC694\uAC00
      \uC788\uACA0\uB2E4.</i>\"\n<i>\uC5B4\uB514\uC120\uAC00 <b>\uC2DC\uAC04</b>\uC5D0
      \uB300\uD55C \uD78C\uD2B8\uAC00 \uC788\uB358 \uAC83 \uAC19\uC740\uB370...</i>\"\uBA54\uBAA8\uAC00
      \uC801\uD600\uC788\uB2E4. <b>\uBB34\uC9C0\uAC1C</b>\uAC00 \uB72C \uD558\uB298
      \uC544\uB798, <i>\uC2DC\uAC04\uC774 \uC9C0\uB098\uB3C4 \uBC14\uB798\uC9C0 \uC54A\uB294
      \uAC83</i>\uB4E4\uB9CC \uB0A8\uAE30\uACE0 \uBAA8\uB450 \uD0C0\uC11C \uC0AC\uB77C\uC9C0\uB9AC\uB77C.\\\n\uB300\uCCB4
      \uBB34\uC2A8 \uC77C\uC774 \uC788\uC5C8\uB358 \uAC78\uAE4C?\"\n<i>\uADF8\uB098\uC800\uB098
      \uC11C\uB78D\uC5D0 \uC5F4\uC1E0\uAC00 \uC788\uB2E4\uACE0?</i>\"\uC11C\uC138\uC1E0\uC218\uC220\uC2A4\uC2DC\uC2DD\uC4F8\uC54A\uC57C\uC591\uC5B4\uC5B8\uC5BC\uC5C6\uC5F4\uC660\uC6A9\uC6B0\uC73C\uC740\uC744\uC774\uC77C\uC77D\uC788\uC790\uC7A5\uC804\uC9C0\uCA4C\uCC45\uCC9C\uD14C\uD2B8\uD558\uD55C\uD560\uD574\uD5C8\uD5D8\uD63C\uD654_\uB05D\uD0D0\uC815\uC740
      \uC758\uBB38\uC758<color=blue>\uB450 \uCF58\uC194 \uD14C\uC774\uBE14 \uC704\uC5D0
      \uB193\uC778 <b>\uD3B8\uC9C0</b>\uB2E4. \uC885\uC774\uAC00 \uB9CE\uC774 \uBC14\uB798\uC84C\uB2E4.\uBC88\uC9F8
      \uC5F4\uC1E0</color>. \uC5B4\uB514\uC5D0 \"\uD589\uBCF5\uD574\uBCF4\uC774\uB294
      \uAC00\uC871\uC0AC\uC9C4\uC774\uB2E4.\uCCAB\uBC88\uC9F8 \uC790\uBB3C\uC1E0\uCD1B\uBD88\uCCAB
      \uBC88\uC9F8 \uC5F4\uC1E0\uC9C0\uD3EC \uB77C\uC774\uD130\uB450 \uBC88\uC9F8
      \uC5F4\uC1E0\"<b>\uC544\uAC00\uC528\uAED8.\uBCA0\uC77C\uB9AC\uC758 \uD3B8\uC9C0\uBCA0\uC77C\uB9AC\uC758
      \uC77C\uAE30\uCF58\uC194 \uD14C\uC774\uBE14 \uC704\uC5D0 \uB193\uC778 <b>\uD3B8\uC9C0</b>\uB2E4.
      \uC885\uC774\uAC00 \uB9CE\uC774 \uBC14\uB798\uC84C\uB2E4.</b>\n\"\uB204\uAD70\uAC00\uC758
      <b>\uC77C\uAE30</b>\uCC98\uB7FC \uBCF4\uC778\uB2E4.\"\uC608\uC05C \uC544\uAC00\uC528\uAC00
      \uD0DC\uC5B4\uB0AC\uB2E4. \uC800\uD0DD\uC740 \uD55C \uB2EC\uC9F8 \uCD95\uC81C\uAC00
      \uBC8C\uC5B4\uC9C4 \uAC83\uB9CC \uAC19\uB2E4.\n\uBD80\uC778\uC758 \uBAB8\uC774
      \uC870\uAE08 \uD3B8\uCC2E\uC9C0\uB9CC, \uADF8\uB798\uB3C4 \uC800\uD0DD\uC758
      \uBAA8\uB450\uAC00 \uC544\uAC00\uC528\uC758 \uD0C4\uC0DD\uC744 \uCD95\uD558\uD558\uACE0
      \uC788\uB2E4.\n\uC8FC\uC778\uB2D8 \uB450 \uBD84\uB4E4\uC740 \uC544\uAC00\uC528\uB97C
      \uB108\uBB34\uB098 \uC544\uB07C\uACE0, \uC0AC\uC6A9\uC778\uC778 \uC6B0\uB9AC\uB4E4
      \uC5ED\uC2DC \uC608\uC678\uB294 \uC5C6\uB2E4.\n\uC0AD\uB9C9\uD588\uB358 \uC800\uD0DD\uC5D0
      \uBD04\uC774 \uC628 \uAC83 \uAC19\uB2E4.\n\uC0AC\uC6A9\uC778\uB4E4\uC740 \uC544\uAC00\uC528\uC758
      \uC0DD\uC77C\uC778 <b>6\uC6D4 15\uC77C</b>\uC744 \uAE30\uB150\uC77C\uB85C \uC815\uD574\uC57C
      \uD55C\uB2E4\uACE0 \uD55C\uC785\uC744 \uBAA8\uC544 \uC598\uAE30\uD55C\uB2E4.\n\n\uC544\uAC00\uC528\uAC00
      \uC465\uC465 \uD06C\uC154\uC11C \uB9D0\uC744 \uC54C\uC544\uB4E4\uC744 \uC218
      \uC788\uB294 \uB098\uC774\uAC00 \uB418\uC2DC\uBA74 \uB9D0\uD574\uB4DC\uB824\uC57C\uC9C0!\n<i>\"\"
      \uC544\uAC00\uC528\uB294 \uC6B0\uB9AC\uC758 <b>\uCD95\uBCF5</b>\uC774\uC608\uC694!
      \uADF8\uB9AC\uACE0, <b>\uCD95\uBCF5</b>\uC758 \uC2DC\uAC04\uC774 \uB418\uBA74,
      \uC6B0\uB9AC <b>\uCD95\uBCF5</b>\uC758 \uC544\uB798, \uC120\uBB3C\uACFC \uD568\uAED8
      \uC55E\uC73C\uB85C \uB098\uC544\uAC08 \uC218 \uC788\uB294 \uAE38\uC774 \uB098\uD0C0\uB0A0
      \uAC70\uC608\uC694. \"\"</i>\n\n             XX\uB144 X\uC6D4 \uD558\uB140
      \uBCA0\uC77C\uB9AC\uC758 \uC77C\uAE30.\"\n\uD760... \uBAB0\uB798 \uD55C\uBC88
      \uC77D\uC5B4\uBCFC\uAE4C?\"\n\uC544\uAC00\uC528. \uC800\uD0DD\uC758 \uBAA8\uB4E0
      \uC0AC\uC6A9\uC778\uB4E4\uC774 \uB5A0\uB0AC\uC5B4\uC694.\n<b>\uC0AC\uB77C\uC9C4
      \uC544\uAC00\uC528</b>\uC640, <b>\uBBF8\uCCD0\uBC84\uB9B0 \uC8FC\uC778\uB2D8</b>,
      \uACE0\uB9BD\uB41C \uC800\uD0DD ...\n\uADF8\uB807\uAC8C \uBAA8\uB450 \uD558\uB098\uB458\uC529
      \uB5A0\uB098\uACE0, \uC800\uB9CC \uB0A8\uC558\uC5B4\uC694.\n\uD639\uC2DC \uC544\uAC00\uC528\uAED8\uC11C
      \uB3CC\uC544\uC624\uC2DC\uC9C0 \uC54A\uC744\uAE4C \uAE30\uB2E4\uB838\uC9C0\uB9CC..
      \uC774\uC81C \uD55C\uACC4\uC608\uC694.\n\uC774\uACF3\uC5D4 \uC0AC\uB78C\uB3C4,
      \uC628\uAE30\uB3C4, \uBA39\uC744 \uAC83\uB3C4, \uADF8 \uBB34\uC5C7\uB3C4 \uC874\uC7AC\uD558\uC9C0\uC54A\uB294
      <b>\uC720\uB839 \uC800\uD0DD</b>\uC774 \uB418\uC5C8\uC5B4\uC694.\n\uC544\uAC00\uC528\uB97C
      \uC774\uD574\uD558\uC9C0\uB9CC... \uD55C\uD3B8\uC73C\uB85C\uB294 \uC6D0\uB9DD\uC2A4\uB7FD\uC2B5\uB2C8\uB2E4.\n\n\uD639\uC2DC\uB098
      \uB3CC\uC544\uC62C \uC544\uAC00\uC528\uB97C \uC704\uD574, \uC81C\uAC00 \uC9C0\uB154\uB358
      \uC5F4\uC1E0\uB97C \uC11C\uB78D \uC548\uC5D0 \uB450\uACE0 \uAC08\uAC8C\uC694.\n\uBD80\uB514...
      \uD589\uBCF5\uD558\uC138\uC694, \uC544\uAC00\uC528.\n\n                   
      <b>\uD558\uB140 \uBCA0\uC77C\uB9AC\uAC00.</b>\"\n\uBA3C\uC9C0\uAC00 \uAC00\uB4DD
      \uC313\uC778 \uAC78 \uBCF4\uB2C8 \uC624\uB7AB\uB3D9\uC548 \uAD00\uB9AC\uAC00
      \uC548\uB41C \uB4EF\uC8FC\uBA38\uB2C8 \uCE7C \uD558\uB2E4.\"\uC368\uC57C \uD560\uC9C0\uB294
      \uC790\uBA85\uD558\uB2E4. \uD3B8\uC9C0\uB97C \uBC1B\uC544 \uC800\uD0DD\uC5D0
      \uB4E4\uC5B4\uC624\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4.\uAC00\uB054\uC740
