    ItemName: "\uCCAB \uBC88\uC9F8 \uC5F4\uC1E0"
    Type: Pickable
    Description: "<color=blue>\uCCAB \uBC88\uC9F8 \uC5F4\uC1E0</color>. \uBCA0\uC77C\uB9AC\uB77C\uB294
      \uD558\uB140\uAC00 \uBCF4\uAD00\uD588\uB358 \uC5F4\uC1E0\uB2E4."
    IconName: Icons_2
    PairID: 100
  - ItemID: 10001004
    ItemName: "\uC9C0\uD3EC \uB77C\uC774\uD130"
    Type: Pickable
    Description: "\uACE0\uAE09\uC2A4\uB7FD\uAC8C \uC0DD\uAE34 <b>\uC9C0\uD3EC \uB77C\uC774\uD130</b>\uB2E4.\n<i>\uBD88\uC744
      \uC0AC\uC6A9\uD560 \uB370\uAC00 \uC788\uC744\uAE4C?</i>"
    IconName: Icons_3
    PairID: 101
  - ItemID: 10001005
    ItemName: "\uB450 \uBC88\uC9F8 \uC5F4\uC1E0"
    Type: Pickable
    Description: "<color=blue>\uB450 \uBC88\uC9F8 \uC5F4\uC1E0</color>. \uC5B4\uB514\uC5D0
      \uC368\uC57C \uD560\uC9C0\uB294 \uC790\uBA85\uD558\uB2E4."
    IconName: Icons_2
    PairID: 102
  - ItemID: 10001006
    ItemName: "\uC8FC\uBA38\uB2C8 \uCE7C"
    Type: Pickable
    Description: "\uC0AC\uC6A9\uAC10\uC774 \uB9CE\uC740 \uC791\uC740 \uCE7C.\n\uC4F8
      \uB370\uAC00 \uC5B4\uB518\uAC00\uC5D4 \uC788\uACA0\uC9C0?"
    IconName: Icons_4
    PairID: 103
  Interactable:
  - ItemID: 20001001
    ItemName: "\uB0A1\uC740 \uC790\uBB3C\uC1E0"
    Type: Interactable
    Monologue: "<b>\uBB34\uC5B8\uAC00 \uD5C8\uC220\uD55C</b> \uC790\uBB3C\uC1E0\uB2E4."
    DeactiveMSG: "<b>\uBB34\uC5B8\uAC00 \uD5C8\uC220\uD55C</b> \uC790\uBB3C\uC1E0\uB2E4.\n<i>\uC5B4\uCA4C\uBA74
      \uB9DE\uB294 \uC5F4\uC1E0\uAC00 \uC788\uC744\uC9C0\uB3C4..?</i>"
    PairID: -1
  - ItemID: 20001002
    ItemName: "\uB0A1\uC740 \uCC45\uC7A5"
    Type: Interactable
    Monologue: "<b>\uBB54\uAC00\uB97C \uAF42\uC744 \uC218 \uC788\uB294 \uCC45\uC7A5</b>"
    DeactiveMSG: "<b>\uBB54\uAC00\uB97C \uAF42\uC744 \uC218 \uC788\uB294 \uCC45\uC7A5</b>\n<i>\uD63C\uC790
      \uB180\uACE0\uC788\uB294 \uCC45\uC744 \uC5B4\uB514\uC11C \uBCF8 \uAC83 \uAC19\uC740\uB370...</i>"
    PairID: -1
  - ItemID: 20001003
    ItemName: "\uCCAB\uBC88\uC9F8 \uC790\uBB3C\uC1E0"
    Type: Interactable
    Monologue: "<color=blue>\uCCAB \uBC88\uC9F8</color> \uC790\uBB3C\uC1E0.\n\uC774
      \uBB38 \uB108\uBA38\uB97C \uC870\uC0AC\uD574\uBCF4\uC790."
    DeactiveMSG: "<color=blue>\uCCAB \uBC88\uC9F8</color> \uC790\uBB3C\uC1E0.\n<i>\uC790\uBB3C\uC1E0\uB77C...
      \uC5F4\uC1E0\uB97C \uC5B4\uB514\uC11C \uBCF8 \uAC83 \uAC19\uAE30\uB3C4?</i>"
    PairID: 100
  - ItemID: 20001004
    ItemName: "\uCD1B\uBD88"
    Type: Interactable
    Monologue: "\uC65C\uC778\uC9C0 \uBAA8\uB974\uAC8C \uC628\uAE30\uAC00 \uB0A8\uC544\uC788\uB294
      \uAC83 \uAC19\uC740 \uCD1B\uBD88\uC774\uB2E4.\n<i>\uCD1B\uBD88\uC744 \uC77C\uB82C\uB85C
      \uB098\uC5F4\uD574\uB193\uC740 \uAC83\uC774 \uD2B9\uC774\uD558\uAD70.</i>"
    DeactiveMSG: "\uC77C\uB82C\uB85C \uB098\uC5F4\uB41C \uCD1B\uBD88\uC774\uB2E4.\n<i>\uC5B4\uB5A4
      \uCD1B\uBD88\uC740 \uB179\uC544 \uD0A4\uAC00 \uC791\uACE0, \uC5B4\uB5A4 \uCD1B\uBD88\uC740
      \uBE44\uAD50\uC801 \uC0C8\uAC70 \uAC19\uAD70.. \uC774\uAC8C \uD78C\uD2B8\uC77C\uAE4C?</i>"
    PairID: 101
  Inspectable:
  - ItemID: 30001001
    ItemName: "\uB0A1\uC740 \uC591\uB3D9\uC774"
    Type: Inspectable
    Monologue: "<i>\uC5F4\uB9AC\uC9C0 \uC54A\uB294</i> \uC774\uC0C1\uD55C \uC591\uB3D9\uC774\uB2E4."
  - ItemID: 30001002
    ItemName: "\uBA3C\uC9C0\uC313\uC778 \uAC00\uC871\uC0AC\uC9C4"
    Type: Inspectable
    Monologue: "\uD589\uBCF5\uD574\uBCF4\uC774\uB294 \uAC00\uC871\uC0AC\uC9C4\uC774\uB2E4.\n\uBA3C\uC9C0\uAC00
      \uAC00\uB4DD \uC313\uC778 \uAC78 \uBCF4\uB2C8 \uC624\uB7AB\uB3D9\uC548 \uAD00\uB9AC\uAC00
      \uC548\uB41C \uB4EF \uD558\uB2E4."
  - ItemID: 30001003
    ItemName: "\uC791\uC740 \uBA54\uBAA8\uC9C0"
    Type: Inspectable
    Monologue: "\uBA54\uBAA8\uAC00 \uC801\uD600\uC788\uB2E4. \n<b>\uBB34\uC9C0\uAC1C</b>\uAC00
      \uB72C \uD558\uB298 \uC544\uB798, <i>\uC2DC\uAC04\uC774 \uC9C0\uB098\uB3C4
      \uBC14\uB798\uC9C0 \uC54A\uB294 \uAC83</i>\uB4E4\uB9CC \uB0A8\uAE30\uACE0 \uBAA8\uB450
      \uD0C0\uC11C \uC0AC\uB77C\uC9C0\uB9AC\uB77C."
  - ItemID: 30001004
    ItemName: "\uD53C\uBB3B\uC740 \uC815\uBB3C\uD654"
    Type: Inspectable
    Monologue: "\uD53C\uAC00 \uBB3B\uC5B4\uC788\uB294 \uC815\uBB3C\uD654\uB2E4. \uC791\uC740
      \uBA54\uBAA8\uAC00 \uBD99\uC5B4\uC788\uB2E4.\n<i>\uC815\uBB3C\uD654\uC5D0 \uAD00\uD55C
      \uBA54\uBAA8\uC9C0\uC77C\uAE4C? \uC790\uC138\uD788 \uBCFC \uD544\uC694\uAC00
      \uC788\uACA0\uB2E4.</i>"
  Readable:
  - ItemID: 40001001
    ItemName: "\uB0A1\uC740 \uC77C\uAE30"
    Type: Readable
    Monologue: "\uC660\uC9C0 <b>\uC77D\uC5B4\uC57C \uD560 \uAC83 \uAC19\uC740</b>
      \uC77C\uAE30\uB2E4."
    Narrative: "\uAE34\uAE00\uD14C\uC2A4\uD2B82 \uB3D9\uD574\uBB3C\uACFC \uBC31\uB450\uC0B0\uC774
      \uB9C8\uB974\uACE0\uB2F3\uB3C4\uB85D \uD558\uB290\uB2D8\uC774 \uBCF4\uC6B0\uD558\uC0AC
      \uC6B0\uB9AC\uB098\uB77C\uB9CC\uC138 \uBB34\uAD81\uD654 \uC0BC\uCC9C\uB9AC
      \uD654\uB824\uAC15\uC0B0 \uB300\uD55C\uC0AC\uB78C \uB300\uD55C\uC73C\uB85C
      \uAE38\uC774\uBCF4\uC804\uD558\uC138\uB3D9\uD574\uBB3C\uACFC \uBC31\uB450\uC0B0\uC774
      \uB9C8\uB974\uACE0\uB2F3\uB3C4\uB85D \uD558\uB290\uB2D8\uC774 \uBCF4\uC6B0\uD558\uC0AC
      \uC6B0\uB9AC\uB098\uB77C\uB9CC\uC138 \uBB34\uAD81\uD654 \uC0BC\uCC9C\uB9AC
      \uD654\uB824\uAC15\uC0B0 \uB300\uD55C\uC0AC\uB78C \uB300\uD55C\uC73C\uB85C
      \uAE38\uC774\uBCF4\uC804\uD558\uC138\uB3D9\uD574\uBB3C\uACFC \uBC31\uB450\uC0B0\uC774
      \uB9C8\uB974\uACE0\uB2F3\uB3C4\uB85D \uD558\uB290\uB2D8\uC774 \uBCF4\uC6B0\uD558\uC0AC
      \uC6B0\uB9AC\uB098\uB77C\uB9CC\uC138 \uBB34\uAD81\uD654 \uC0BC\uCC9C\uB9AC
      \uD654\uB824\uAC15\uC0B0 \uB300\uD55C\uC0AC\uB78C \uB300\uD55C\uC73C\uB85C
      \uAE38\uC774\uBCF4\uC804\uD558\uC138\uB3D9\uD574\uBB3C\uACFC \uBC31\uB450\uC0B0\uC774
      \uB9C8\uB974\uACE0\uB2F3\uB3C4\uB85D \uD558\uB290\uB2D8\uC774 \uBCF4\uC6B0\uD558\uC0AC
      \uC6B0\uB9AC\uB098\uB77C\uB9CC\uC138 \uBB34\uAD81\uD654 \uC0BC\uCC9C\uB9AC
      \uD654\uB824\uAC15\uC0B0 \uB300\uD55C\uC0AC\uB78C \uB300\uD55C\uC73C\uB85C
      \uAE38\uC774\uBCF4\uC804\uD558\uC138\uB3D9\uD574\uBB3C\uACFC \uBC31\uB450\uC0B0\uC774
      \uB9C8\uB974\uACE0\uB2F3\uB3C4\uB85D \uD558\uB290\uB2D8\uC774 \uBCF4\uC6B0\uD558\uC0AC
      \uC6B0\uB9AC\uB098\uB77C\uB9CC\uC138 \uBB34\uAD81\uD654 \uC0BC\uCC9C\uB9AC
      \uD654\uB824\uAC15\uC0B0 \uB300\uD55C\uC0AC\uB78C \uB300\uD55C\uC73C\uB85C
      \uAE38\uC774\uBCF4\uC804\uD558\uC138 \n\uB2E4\uC774\uC5BC\uB85C\uADF8 <color=red>\uB05D!</color>"
    Reply: "<i>\uC4F8\uB370\uC5C6\uC774 \uAE34\uAE00 \uAC19\uB2E4...</i>"
  - ItemID: 40001002
    ItemName: "\uBCA0\uC77C\uB9AC\uC758 \uD3B8\uC9C0"
    Type: Readable
    Monologue: "\uCF58\uC194 \uD14C\uC774\uBE14 \uC704\uC5D0 \uB193\uC778 <b>\uD3B8\uC9C0</b>\uB2E4.
      \uC885\uC774\uAC00 \uB9CE\uC774 \uBC14\uB798\uC84C\uB2E4."
    Narrative: "<b>\uC544\uAC00\uC528\uAED8.</b>\n\n\uC544\uAC00\uC528. \uC800\uD0DD\uC758
      \uBAA8\uB4E0 \uC0AC\uC6A9\uC778\uB4E4\uC774 \uB5A0\uB0AC\uC5B4\uC694.\n<b>\uC0AC\uB77C\uC9C4
      \uC544\uAC00\uC528</b>\uC640, <b>\uBBF8\uCCD0\uBC84\uB9B0 \uC8FC\uC778\uB2D8</b>,
      \uACE0\uB9BD\uB41C \uC800\uD0DD ...\n\uADF8\uB807\uAC8C \uBAA8\uB450 \uD558\uB098\uB458\uC529
      \uB5A0\uB098\uACE0, \uC800\uB9CC \uB0A8\uC558\uC5B4\uC694.\n\uD639\uC2DC \uC544\uAC00\uC528\uAED8\uC11C
      \uB3CC\uC544\uC624\uC2DC\uC9C0 \uC54A\uC744\uAE4C \uAE30\uB2E4\uB838\uC9C0\uB9CC..
      \uC774\uC81C \uD55C\uACC4\uC608\uC694.\n\uC774\uACF3\uC5D4 \uC0AC\uB78C\uB3C4,
      \uC628\uAE30\uB3C4, \uBA39\uC744 \uAC83\uB3C4, \uADF8 \uBB34\uC5C7\uB3C4 \uC874\uC7AC\uD558\uC9C0\uC54A\uB294
      <b>\uC720\uB839 \uC800\uD0DD</b>\uC774 \uB418\uC5C8\uC5B4\uC694.\n\uC544\uAC00\uC528\uB97C
      \uC774\uD574\uD558\uC9C0\uB9CC... \uD55C\uD3B8\uC73C\uB85C\uB294 \uC6D0\uB9DD\uC2A4\uB7FD\uC2B5\uB2C8\uB2E4.\n\n\uD639\uC2DC\uB098
      \uB3CC\uC544\uC62C \uC544\uAC00\uC528\uB97C \uC704\uD574, \uC81C\uAC00 \uC9C0\uB154\uB358
      \uC5F4\uC1E0\uB97C \uC11C\uB78D \uC548\uC5D0 \uB450\uACE0 \uAC08\uAC8C\uC694.\n\uBD80\uB514...
      \uD589\uBCF5\uD558\uC138\uC694, \uC544\uAC00\uC528.\n\n                   
      <b>\uD558\uB140 \uBCA0\uC77C\uB9AC\uAC00.</b>"
    Reply: "\uAF64 \uC624\uB798\uB41C \uD3B8\uC9C0 \uAC19\uC740\uB370. <b>\uC0AC\uB77C\uC9C4
      \uC544\uAC00\uC528\uC640 \uC720\uB839 \uC800\uD0DD</b>\uC774\uB77C.. \uD765\uBBF8\uB86D\uAD70.\n<i>\uADF8\uB098\uC800\uB098
      \uC11C\uB78D\uC5D0 \uC5F4\uC1E0\uAC00 \uC788\uB2E4\uACE0?</i>"
  - ItemID: 40001003
    ItemName: "\uBCA0\uC77C\uB9AC\uC758 \uC77C\uAE30"
    Type: Readable
    Monologue: "\uB204\uAD70\uAC00\uC758 <b>\uC77C\uAE30</b>\uCC98\uB7FC \uBCF4\uC778\uB2E4.\n\uD760...
      \uBAB0\uB798 \uD55C\uBC88 \uC77D\uC5B4\uBCFC\uAE4C?"
    Narrative: "\uC608\uC05C \uC544\uAC00\uC528\uAC00 \uD0DC\uC5B4\uB0AC\uB2E4. \uC800\uD0DD\uC740
      \uD55C \uB2EC\uC9F8 \uCD95\uC81C\uAC00 \uBC8C\uC5B4\uC9C4 \uAC83\uB9CC \uAC19\uB2E4.\n\uBD80\uC778\uC758
      \uBAB8\uC774 \uC870\uAE08 \uD3B8\uCC2E\uC9C0\uB9CC, \uADF8\uB798\uB3C4 \uC800\uD0DD\uC758
      \uBAA8\uB450\uAC00 \uC544\uAC00\uC528\uC758 \uD0C4\uC0DD\uC744 \uCD95\uD558\uD558\uACE0
      \uC788\uB2E4.\n\uC8FC\uC778\uB2D8 \uB450 \uBD84\uB4E4\uC740 \uC544\uAC00\uC528\uB97C
      \uB108\uBB34\uB098 \uC544\uB07C\uACE0, \uC0AC\uC6A9\uC778\uC778 \uC6B0\uB9AC\uB4E4
      \uC5ED\uC2DC \uC608\uC678\uB294 \uC5C6\uB2E4.\n\uC0AD\uB9C9\uD588\uB358 \uC800\uD0DD\uC5D0
      \uBD04\uC774 \uC628 \uAC83 \uAC19\uB2E4.\n\uC0AC\uC6A9\uC778\uB4E4\uC740 \uC544\uAC00\uC528\uC758
      \uC0DD\uC77C\uC778 <b>6\uC6D4 15\uC77C</b>\uC744 \uAE30\uB150\uC77C\uB85C \uC815\uD574\uC57C
      \uD55C\uB2E4\uACE0 \uD55C\uC785\uC744 \uBAA8\uC544 \uC598\uAE30\uD55C\uB2E4.\n\n\uC544\uAC00\uC528\uAC00
      \uC465\uC465 \uD06C\uC154\uC11C \uB9D0\uC744 \uC54C\uC544\uB4E4\uC744 \uC218
      \uC788\uB294 \uB098\uC774\uAC00 \uB418\uC2DC\uBA74 \uB9D0\uD574\uB4DC\uB824\uC57C\uC9C0!\n<i>\"
      \uC544\uAC00\uC528\uB294 \uC6B0\uB9AC\uC758 <b>\uCD95\uBCF5</b>\uC774\uC608\uC694!
      \uADF8\uB9AC\uACE0, <b>\uCD95\uBCF5</b>\uC758 \uC2DC\uAC04\uC774 \uB418\uBA74,
      \uC6B0\uB9AC <b>\uCD95\uBCF5</b>\uC758 \uC544\uB798, \uC120\uBB3C\uACFC \uD568\uAED8
      \uC55E\uC73C\uB85C \uB098\uC544\uAC08 \uC218 \uC788\uB294 \uAE38\uC774 \uB098\uD0C0\uB0A0
      \uAC70\uC608\uC694. \"</i>\n\n             XX\uB144 X\uC6D4 \uD558\uB140 \uBCA0\uC77C\uB9AC\uC758
      \uC77C\uAE30."
    Reply: "\uD654\uBAA9\uD588\uB358 \uAC83\uB9CC \uAC19\uC740 \uC800\uD0DD\uC778\uB370..\n\uB300\uCCB4
      \uBB34\uC2A8 \uC77C\uC774 \uC788\uC5C8\uB358 \uAC78\uAE4C?"
  Special:
  - ItemID: 50001001
    ItemName: "\uC870\uC791\uAC00\uB2A5\uD55C \uC2DC\uACC4"
    Type: Special
    Monologue: "\uBA48\uCDB0\uBC84\uB9B0 \uC2DC\uACC4\uB2E4.\n<i>\uC5B4\uB514\uC120\uAC00
      <b>\uC2DC\uAC04</b>\uC5D0 \uB300\uD55C \uD78C\uD2B8\uAC00 \uC788\uB358 \uAC83
      \uAC19\uC740\uB370...</i>"
    EventType: 0
