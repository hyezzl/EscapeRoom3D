  eventAfter:
  - EventID: E001
    EventInfo: "\uB300\uBB38\uC744 \uC5F4\uACE0 \uB4E4\uC5B4\uC654\uC744 \uB54C"
    Dialog: "\"\uBC29\uAE08 \uC5F4\uACE0 \uB4E4\uC5B4\uC628 \uB300\uBB38\uC774 \uC7A0\uACBC\uB2E4.
      \uADC0\uC2E0\uC774 \uACE1\uD560 \uB178\uB987\uC774\uAD70.\n<i>\uB2E4\uC2DC
      \uB098\uAC08 \uC218 \uC788\uB294 \uBC29\uBC95\uC744 \uCC3E\uC544\uBCF4\uC790</i>\""
  - EventID: E002
    EventInfo: "\uD50C\uB808\uC774\uC5B4 \uC870\uC791 \uC9C1\uC804"
    Dialog: "\uC660\uC9C0 \uC73C\uC2A4\uC2A4\uD55C \uAE30\uBD84\uC774 \uB4E0\uB2E4.\n\uC5B4\uB450\uC6B0\uB2C8
      <b>\uB7A8\uD504</b>\uB97C \uC0AC\uC6A9\uD558\uC790."
  - EventID: E003
    EventInfo: "\uBB38\uC5D0 \uB2E4\uAC00\uAC14\uC744 \uB54C"
    Dialog: "\uBCF5\uB3C4\uC5D0 \uC788\uB294 \uAC70\uB77C\uACE4 \uBB38\uBFD0\uC774\uB2C8
      \uBCC4\uC218 \uC5C6\uC744 \uAC83 \uAC19\uB2E4. \uB4E4\uC5B4\uAC00 \uBCF4\uC790.\n<i>\uC790\uBB3C\uC1E0\uB77C...
      \uC5F4\uC1E0\uAC00 \uC5B4\uB514\uC5D0 \uC788\uB358 \uAC83 \uAC19\uAE30\uB3C4..?</i>"
  - EventID: E004
    EventInfo: "\uCD1B\uBD88 \uD37C\uC990\uC744 \uD480\uC5C8\uC744 \uB54C"
    Dialog: "\uC774\uB7F0 \uC7A5\uCE58\uAC00 \uC228\uACA8\uC838\uC788\uB2E4\uB2C8.
      \uC5ED\uC2DC \uD3C9\uBC94\uD55C \uC800\uD0DD\uC740 \uC544\uB2CC \uAC83 \uAC19\uB2E4.\n<i>\uC5B4\uB514\uC120\uAC00
      \uC7A0\uAE08\uC7A5\uCE58\uAC00 \uD480\uB9B0 \uB4EF\uD55C \uC18C\uB9AC\uAC00
      \uB4E4\uB838\uB2E4. \uCC3E\uC544\uBCF4\uC790.</i>"
  - EventID: E005
    EventInfo: "\uC2DC\uACC4 \uD37C\uC990\uC744 \uD480\uC5C8\uC744 \uB54C"
    Dialog: "<b>\uCD95\uBCF5\uC758 <i>\"\uC2DC\uAC04\"</i></b>\uC774 \uD78C\uD2B8\uC600\uAD70.\n\uADF8\uB2E4\uC74C\uC740...
      <b>\uCD95\uBCF5\uC758 <i>\"\uC544\uB798\"</i></b>\uC600\uB358\uAC00?"
  - EventID: E006
    EventInfo: "\uB9C8\uC9C0\uB9C9 \uC0C1\uC790\uB97C \uC5F4\uC5C8\uC744 \uB54C"
    Dialog: "\uC544\uAE4C \uBD24\uB358 \uC5F4\uC1E0\uC640 \uBE44\uC2B7\uD558\uAC8C
      \uC0DD\uAE34 \uC5F4\uC1E0\uB2E4.\n\uC77C\uAE30\uC5D0\uC11C \uADF8\uB7AC\uC9C0.
      <i>\" \uC55E\uC73C\uB85C \uB098\uC544\uAC08 \uC218 \uC788\uB294 \uAE38 \"</i>"
